# Copy to .env and adjust. Matches the Postgres service in docker-compose.yml.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://fairshare:fairshare@localhost:5433/fairshare?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-bytes
TOKEN_TTL=24h
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Tests create and drop their own schema, so they can share the dev database.
TEST_DATABASE_URL=postgres://fairshare:fairshare@localhost:5433/fairshare?sslmode=disable
